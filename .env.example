# Database connection
DATABASE_URL=postgres://headline:headline@localhost:5432/headline_anchor

# Server port
PORT=3000

# BSV wallet private key (hex).
# Required in containerized/Kube deployments where .server-wallet.json won't persist.
# For local dev, omit this — a key auto-generates to .server-wallet.json.
# Generate one with: npm run generate-key
# SERVER_PRIVATE_KEY=

# Float treasury monitoring token (16+ chars), provisioned per app by Float.
# When set, the read-only route GET /treasury/balance is mounted behind bearer auth.
# Omit to leave the route absent (nothing else changes). Rotated independently of the wallet key.
# FLOAT_BALANCE_TOKEN=
